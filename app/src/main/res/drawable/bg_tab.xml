<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item android:gravity="bottom" android:height="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
